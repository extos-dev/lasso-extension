{
  "manifest_version": 3,
  "name": "Lasso — Page Data Extractor",
  "short_name": "Lasso",
  "version": "0.2.0",
  "description": "Point at a page, get clean JSON, CSV or Markdown. Local-first: no account, no cloud, no network.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Open Lasso", "default_icon": { "16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png" } },
  "icons": { "16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png" },
  "side_panel": { "default_path": "src/sidepanel/index.html" },
  "background": { "service_worker": "src/background/service-worker.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'; base-uri 'none'" }
}
