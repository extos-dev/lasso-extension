{
  "name": "lasso-extension",
  "version": "0.2.0",
  "private": true,
  "description": "Lasso — local-first page data extractor (Chrome MV3). No runtime dependencies; jsdom is used for tests only.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:panel && npm run test:fixtures && npm run test:recipe && npm run test:recipe-panel && npm run test:locator",
    "test:unit": "node test/unit.mjs",
    "test:panel": "node test/panel.mjs",
    "test:fixtures": "node test/run-fixtures.mjs",
    "test:recipe": "node test/recipe.mjs",
    "test:recipe-panel": "node test/recipe-panel.mjs",
    "test:locator": "node test/locator.mjs",
    "test:browser": "npm run build && node test/inspect-smoke.mjs",
    "test:all": "npm test && npm run test:browser",
    "test:inspect": "npm run test:browser",
    "perf": "node scripts/perf.mjs",
    "fixtures": "python3 test/make-fixtures.py",
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs dist"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "playwright": "^1.64.1"
  }
}
